<footer class="nexus-footer">

  {# ── Glow divider ───────────────────────────────────── #}
  <div class="nexus-footer__glow" aria-hidden="true"></div>

  {# ── Main Grid ─────────────────────────────────────── #}
  <div class="nexus-footer__body">
    <div class="container grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-6">

      {# Brand column #}
      <div class="lg:col-span-4 rtl:lg:pl-8 ltr:lg:pr-8">
        <a href="{{ link('/') }}" class="nexus-footer__brand">
          <img src="{{ store.logo }}" alt="{{ store.name }}" width="120" height="40" loading="lazy">
        </a>

        {% if store.description %}
          <p class="nexus-footer__tagline">{{ store.description|striptags|slice(0,160) }}</p>
        {% endif %}

        <salla-social class="nexus-footer__social"></salla-social>

        {# VAT #}
        {% if store.settings.tax.number %}
          <div class="nexus-footer__vat">
            {% if store.settings.tax.certificate %}
              <a class="load-img-onclick" data-modal-id="modal-value-tax" href="#/">
                <img width="40" height="50" loading="lazy"
                     src="{{ 'images/s-empty.png' | cdn }}"
                     data-src="{{ 'images/tax.png' | cdn(70,70) }}"
                     class="lazy w-10 rounded-sm hover:opacity-70 transition-opacity"
                     alt="VAT certificate">
              </a>
            {% endif %}
            <div>
              <p class="nexus-footer__vat-label">{{ trans('common.elements.tax_number') }}</p>
              <b class="nexus-footer__vat-number">{{ store.settings.tax.number }}</b>
            </div>
          </div>

          {% if store.settings.tax.certificate %}
            <salla-modal sub-title-first
                         sub-title="{{ trans('common.elements.tax_number') }}"
                         modal-title="{{ store.settings.tax.number }}"
                         id="modal-value-tax">
              <div class="flex justify-center">
                <img class="w-full max-w-xs" loading="lazy"
                     src="{{ 'images/s-empty.png' | cdn }}"
                     data-src="{{ store.settings.tax.certificate }}"
                     alt="{{ store.settings.tax.number }}"/>
              </div>
            </salla-modal>
          {% endif %}
        {% endif %}
      </div>

      {# Links column #}
      <div class="lg:col-span-3">
        <h4 class="nexus-footer__heading">{{ trans('blocks.footer.pages_links') }}</h4>
        <salla-menu source="footer" class="nexus-footer__menu"></salla-menu>
      </div>

      {# Contacts column #}
      <div class="lg:col-span-2">
        <h4 class="nexus-footer__heading">{{ trans('blocks.footer.contact_us') }}</h4>
        <salla-contacts class="nexus-footer__contacts"></salla-contacts>
      </div>

      {# App / Payments column #}
      <div class="lg:col-span-3 rtl:lg:pr-8 ltr:lg:pl-8">
        <salla-apps-icons class="nexus-footer__apps"></salla-apps-icons>
      </div>

    </div>
  </div>

  {# ── Bottom Bar ─────────────────────────────────────── #}
  <div class="nexus-footer__bottom">
    <div class="container flex flex-col sm:flex-row items-center justify-between gap-3">
      <span class="nexus-footer__copy">{% hook copyright %}</span>
      <salla-payments class="nexus-footer__payments"></salla-payments>
    </div>
  </div>

  {# Safe-list helper (hidden) #}
  <span class="hidden bottom-2 rtl:pl-24 ltr:pr-24 md:grid-cols-3 opacity-40"></span>

</footer>
